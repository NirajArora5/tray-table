{
  "name": "tray-table",
  "version": "0.4.0",
  "private": true,
  "description": "Offline toddler game for planes, restaurants and big feelings. The game is index.html; everything else is tooling and the native shells.",
  "scripts": {
    "test": "node tests/test.js && node tests/native.js",
    "sim": "node tests/sim.js",
    "serve": "python3 -m http.server 8765",
    "www": "node scripts/www.js",
    "cap:sync": "npm run www && cap sync",
    "ios": "npm run cap:sync && cap open ios",
    "android": "npm run cap:sync && cap open android",
    "assets": "node tools/icons/make.js && capacitor-assets generate --ios --android --iconBackgroundColor \"#2f6fed\" --iconBackgroundColorDark \"#2f6fed\" --splashBackgroundColor \"#f6f8ff\" --splashBackgroundColorDark \"#121622\""
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "jsdom": "^26.0.0"
  }
}
